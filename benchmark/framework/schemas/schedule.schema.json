{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngi541.org/schemas/experiment/schedule-v1.schema.json",
  "title": "NGI541 experiment execution schedule",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "comparison_mode",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-[a-z0-9][a-z0-9-]*-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{6}$"
    },
    "comparison_mode": {
      "type": "string",
      "enum": [
        "single",
        "paired-balanced",
        "fixed",
        "randomized"
      ]
    },
    "random_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "run_id",
          "variant",
          "repetition",
          "parameters"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "run_id": {
            "type": "string",
            "pattern": "^run-\\d{4,}$"
          },
          "pair_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "repetition": {
            "type": "integer",
            "minimum": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
